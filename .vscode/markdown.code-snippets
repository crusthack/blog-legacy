{
  "Blog Post Frontmatter": {
    "scope": "markdown,mdx",
    "prefix": ["post", "frontmatter", "graymatter"],
    "description": "Create blog post gray-matter frontmatter",
    "body": [
      "---",
      "title: '${1:${TM_FILENAME_BASE}}'",
      "date: '${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}'",
      "description: '${2}'",
      "titleSlide: ${3|true,false|}",
      "---",
      "",
      "# ${1:${TM_FILENAME_BASE}}",
      "",
      "$0"
    ]
  },
  "Minimal Blog Post Frontmatter": {
    "scope": "markdown,mdx",
    "prefix": ["post-min", "frontmatter-min"],
    "description": "Create minimal blog post gray-matter frontmatter",
    "body": [
      "---",
      "title: '${1:${TM_FILENAME_BASE}}'",
      "date: '${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}'",
      "description: '${2}'",
      "---",
      "",
      "$0"
    ]
  }
}
